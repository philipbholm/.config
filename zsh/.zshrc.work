# Work dev environment — git worktrees, dev stack, monorepo tooling.
# Sourced from .zshrc only when ~/work exists (work profile). compdef calls
# rely on compinit having already run in .zshrc before this file is sourced.

# Git & worktrees
#
# Worktrees are created natively by Claude Code (EnterWorktree) under
# <repo>/.claude/worktrees/. wt-down tears the current one down.

wt-down() {
  /Users/philip/.config/dev/wt-down.sh "$@"
}

sync-context() {
  /Users/philip/.config/dev/sync-context.sh "$@"
}

# Dev tools

dev() {
  /Users/philip/.config/dev/dev.sh "$@"
}

_dev_completions() {
  local commands=("up" "down" "stop" "start" "restart" "nuke" "status" "exec" "logs" "ps" "build")
  _describe 'command' commands
}
compdef _dev_completions dev

fix() {
  /Users/philip/.config/dev/fix.sh "$@"
}

_fix_completions() {
  local cmds=("build:Rebuild Docker images" "full:npm install + rebuild")
  _describe 'command' cmds
}
compdef _fix_completions fix

prisma() {
  local monorepo_root
  monorepo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Error: Not inside a git repository"
    return 1
  }
  . /Users/philip/.config/dev/lib/workspace.sh || return 1
  # dev.sh hands worktrees slots 1-9 and only writes the slot file once a stack
  # is up; the main checkout is slot 0. So an unresolved worktree slot must
  # refuse rather than fall back to port 5432 — that is the main database.
  local slot=0
  if dev_is_worktree_repo "$monorepo_root"; then
    slot=$(dev_slot_for_repo "$monorepo_root")
    if [[ ! "$slot" =~ ^[1-9]$ ]]; then
      echo "Error: no dev stack for this worktree — run \`dev up postgres -d\` first" >&2
      return 1
    fi
  fi
  local port=$((5432 + slot * 100))
  (cd "$monorepo_root/services/registries" &&
    POSTGRES_URL="postgresql://postgres:postgres@localhost:$port/registries" \
      npx prisma studio "$@")
}
