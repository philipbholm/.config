<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.philip.theme-watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/philip/.config/switch-theme.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Check every minute so a deferred terminal theme catches up after the
         last terminal agent exits. The hourly calendar trigger also runs at
         07:00 and 18:00; switch-theme.sh derives the mode from the local clock. -->
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/tmp/theme-watcher.err</string>
</dict>
</plist>
