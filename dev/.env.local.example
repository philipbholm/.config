# Per-developer overrides sourced by ~/.config/dev/dev.sh.
# Variables here are auto-exported and visible to `docker compose`.
#
# Copy to .env.local and fill in your own values. See the
# "Helsenorge / patient-bff demo setup" section of dev/README.md.

# Reserved ngrok subdomain forwarding to patient-bff (host port 4010+offset).
# Used as PATIENT_BFF_PUBLIC_URL in registries — stamped into Helsenorge
# Task.instantiatesUri (must be HTTPS, FHIR code 2174 otherwise).
NGROK_PATIENT_BFF_URL=

# NHN Helsenorge test environment — pin to HN2. HN1 has been observed
# returning "Tjenesten er midlertidig ikke tilgjengelig" on the citizen
# portal even while its API still accepts oppgaves, so sends silently
# don't reach the patient. HN2 is more stable; use it for all demos.
HELSENORGE_OPPGAVE_BASE_URL=
