# Personal-only packages. Installed by install-personal.sh on top of the core Brewfile.
brew "ansible"
# myos backup checks and the restore runbook use it against Hetzner object storage.
brew "awscli"
brew "hcloud"
brew "helm"
brew "k3d"
brew "opentofu"
brew "postgresql@17"
# The CronJob scripts the checks run need a modern bash; macOS ships 3.2.
brew "bash"
# myos scripts/check.sh runs the CI jobs locally. Colima runs the Docker
# engine in a Lima VM, without Docker Desktop, for the image jobs. Start it
# with `colima start --cpu 2 --memory 4 --mount $HOME:w --mount /var/folders:w`
# and stop it after checking. Some checks bind-mount files from mktemp, which
# lives under /var/folders; Colima shares only $HOME unless told otherwise.
brew "colima"
brew "docker"
brew "docker-buildx"
# GNU date as gdate: myos tests run Linux CronJob scripts that call date -d.
brew "coreutils"
# Builds the MinIO test server the app job starts.
brew "go"
# promtool, alloy, vmalert-tool and victoria-metrics for the manifests and
# scripts jobs. CI downloads the versions pinned in scripts/ci/lib.sh; these
# follow Homebrew, so a local pass can drift slightly from CI.
brew "prometheus"
brew "grafana-alloy"
brew "victoriametrics"
cask "brave-browser"
# Opens the myos dev server on the iPhone over HTTPS: `tailscale serve`
# proxies https://<mac>.<tailnet>.ts.net to localhost:3000, reachable only
# from devices signed into the same tailnet. The cask is the menu-bar app,
# which runs the network extension and the sign-in flow; the `tailscale`
# formula is the bare daemon, which needs root to run.
cask "tailscale-app"
