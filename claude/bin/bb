#!/usr/bin/env bash
# bb — Bitbucket Cloud REST API wrapper
# Authenticates with $BITBUCKET_TOKEN (workspace access token).
# Path is appended to https://api.bitbucket.org/2.0
#
# Usage: bb <METHOD> <PATH> [curl-args...]
#
# Examples:
#   bb GET  /repositories/ledidi-code/REPO
#   bb GET  /repositories/ledidi-code/REPO/pullrequests?state=OPEN
#   bb POST /repositories/ledidi-code/REPO/pullrequests -d @pr.json
#   bb GET  /repositories/ledidi-code/REPO/pipelines/?sort=-created_on

set -euo pipefail

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

[[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]] && usage 0
[[ $# -lt 2 ]] && usage 1

if [[ -z "${BITBUCKET_TOKEN:-}" ]]; then
  echo "bb: BITBUCKET_TOKEN is not set" >&2
  exit 1
fi

method="$1"
path="$2"
shift 2

if [[ "$path" != /* ]]; then
  echo "bb: path must start with / (got: $path)" >&2
  exit 1
fi

body=$(mktemp)
trap 'rm -f "$body"' EXIT

http_code=$(curl -sS \
  -o "$body" \
  -w "%{http_code}" \
  -X "$method" \
  -H "Authorization: Bearer ${BITBUCKET_TOKEN}" \
  -H "Accept: application/json" \
  -H "Content-Type: application/json" \
  "https://api.bitbucket.org/2.0${path}" \
  "$@")

cat "$body"
echo
echo "HTTP $http_code" >&2
[[ "$http_code" =~ ^2 ]]
