{
  "env": {
    "EDITOR": "cursor",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bb:*)",
      "Bash(/Users/philip/.config/claude/bin/bb:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials.json)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*secret*.json)",
      "Read(./.npmrc)",
      "Read(./.netrc)",
      "Read(./**/.aws/**)",
      "Read(./**/.ssh/**)",
      "Read(./**/.zsh_secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(aws sso login --profile production:*)",
      "Bash(aws sso login --profile=production:*)",
      "Bash(AWS_PROFILE=production aws sso login:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/philip/.config/dev/claude-notify.sh stop",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/philip/.config/dev/claude-notify.sh notification",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/philip/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "notifications_disabled",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "subagentModel": "opus"
}
