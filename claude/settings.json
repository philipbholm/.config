{
  "claudeMdExcludes": ["/Users/philip/AGENTS.md"],
  "env": {
    "EDITOR": "cursor",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_BASALT_COVE": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "2000"
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(bb:*)",
      "Bash(/Users/philip/.config/claude/bin/bb:*)",
      "Bash(scripts/prod-read.sh:*)",
      "Bash(./scripts/prod-read.sh:*)"
    ],
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)",
      "Workflow",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials.json)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*secret*.json)",
      "Read(./.npmrc)",
      "Read(./.netrc)",
      "Read(./**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(./**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(./**/.zsh_secrets/**)",
      "Read(./**/.zsh_secrets)",
      "Read(~/.config/zsh/.zsh_secrets)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf ../:*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(aws sso login --profile production:*)",
      "Bash(aws sso login --profile=production:*)",
      "Bash(AWS_PROFILE=production aws sso login:*)",
      "Edit(**/prod-read.sh)"
    ],
    "ask": [
      "Bash(dev nuke:*)",
      "Bash(dev stack destroy:*)",
      "Bash(dev worktree destroy:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/philip/.config/dev/claude-context.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/philip/.claude/statusline-command.sh"
  },
  "modelSettings": {
    "claude-opus-4-8": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5": {
      "effortLevel": "medium"
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "autoCompactWindow": 350000,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "notifications_disabled",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": ""
  }
}
